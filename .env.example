# OpenAI-compatible model config
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=https://api.openrouter.ai/api/v1
MODEL_NAME=gpt-4o-mini

# Admin dashboard protection (required to enable /bookings)
ADMIN_TOKEN=change_me

# Salon timezone (IANA name). Defaults to Asia/Ho_Chi_Minh.
SALON_TIMEZONE=Asia/Ho_Chi_Minh

# Web chat protections
CHAT_RATE_LIMIT=20      # max messages per session per 60s window
MAX_MESSAGE_LENGTH=2000 # max chars per chat message
MAX_AGENTS=100          # max in-memory per-session agents (LRU eviction)
